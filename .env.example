# Runtime connection: nonowner app_rw only. Never expose this to browser/VITE_ vars.
DATABASE_URL=postgresql://app_rw@127.0.0.1:5432/neurosync
# Optional base64 CA PEM; certificate and hostname verification remain enabled.
DATABASE_SSL_CA_BASE64=
# Offline migration/provisioning only. Never configure this in the deployed web app.
MIGRATION_DATABASE_URL=
APP_ORIGIN=http://localhost:5173
PORT=3001
NODE_ENV=development
# local is loopback development only. Production: supabase or oidc.
AUTH_MODE=local
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Set each configured task's provider (openai/anthropic/google) and model together.
AI_CLINICAL_PROVIDER=
AI_CLINICAL_MODEL=
AI_SOAP_PROVIDER=
AI_SOAP_MODEL=
AI_REFERENCE_PROVIDER=
AI_REFERENCE_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Separate nonowner commerce login, with no clinical table access.
BILLING_DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PROFESSIONAL_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
# Local Docker PostgreSQL only.
POSTGRES_PASSWORD=
