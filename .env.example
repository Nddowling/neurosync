# Foundation API only. Copy to .env.local; never commit actual credentials.
# Supply passwords using a private .pgpass/secret provider or your private URLs.
DATABASE_URL=postgresql://app_rw@127.0.0.1:5432/neurosync
# Offline migrations only: must own schema and be allowed to create/alter app_rw.
MIGRATION_DATABASE_URL=postgresql://neurosync_migrator@127.0.0.1:5432/neurosync
PORT=3001
NODE_ENV=development
# Optional local Docker setup; supply a private password in .env.local.
POSTGRES_PASSWORD=
# The legacy frontend still needs its existing Base44 configuration until cutover.
# No Base44 variables are needed by the new API or synthetic tests.
# Auth adapter is not connected in this milestone: protected API routes return 401.
